{
  "name": "flesh-cage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Modern CSS-in-TypeScript with Shadow DOM & Constructable Stylesheets",
  "keywords": [
    "css-in-ts",
    "shadow-dom",
    "constructable-stylesheets",
    "react",
    "web-components",
    "skins",
    "theming",
    "design-system"
  ],
  "license": "MIT",
  "author": "Fernando Camargo <deusmorto@gmail.com>",
  "homepage": "https://github.com/everything-dies/flesh-cage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everything-dies/flesh-cage.git"
  },
  "bugs": {
    "url": "https://github.com/everything-dies/flesh-cage/issues"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "perf"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=playground",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "validate": "turbo run validate",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build lint test && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
