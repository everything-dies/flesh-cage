{
  "name": "@flesh-cage/react",
  "version": "0.0.0",
  "description": "React bindings for flesh-cage: Provider, createShadowComponent, HOC, and hooks",
  "keywords": [
    "react",
    "css-in-ts",
    "shadow-dom",
    "web-components",
    "skins",
    "theming"
  ],
  "license": "MIT",
  "author": "Fernando Camargo <deusmorto@gmail.com>",
  "homepage": "https://github.com/everything-dies/flesh-cage/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everything-dies/flesh-cage.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/everything-dies/flesh-cage/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm-run-all 'validate:*'",
    "validate:package": "publint",
    "validate:types": "attw --pack",
    "validate:size": "size-limit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flesh-cage/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "publint": "^0.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^12.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
