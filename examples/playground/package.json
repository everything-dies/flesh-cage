{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "description": "Playground for testing flesh-cage packages locally",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo; find . -maxdepth 1 -name '*.tsbuildinfo' -delete || true"
  },
  "dependencies": {
    "@everything-dies/flesh-cage": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-eslint2": "^5.0.4"
  }
}
