/react.dev/learn/you-might-not-need-an-effect).\n\n/Users/deusmorto/_dev/flesh-cage/packages/flesh-cage/src/core/use-core.ts:13:25\n  11 |   )\n  12 |\n> 13 |   useLayoutEffect(() => attach(ref.current?.shadowRoot as ShadowRoot), [])\n     |                         ^^^^^^ Avoid calling setState() directly within an effect\n  14 |\n  15 |   useLayoutEffect(() => {\n  16 |     const element = ref.current as HTMLElement","@typescript-eslint/no-confusing-void-expression","Returning a void expression from an arrow function shorthand is forbidden. Please add braces to the arrow function.","CallExpression","invalidVoidExprArrow",{"range":"115","text":"116"},"Returning a void expression from a function is forbidden. Please remove the `return` statement.","invalidVoidExprReturnLast",{"range":"117","text":"118"},{"range":"119","text":"120"},{"range":"121","text":"120"},"@typescript-eslint/no-unnecessary-type-parameters","Type parameter Attribute is used only once in the function signature.","TSTypeParameter","sole",["122"],"Returning a void expression from a function is forbidden. Please move it before the `return` statement.","invalidVoidExprReturn",{"range":"123","text":"124"},"@typescript-eslint/no-unnecessary-condition","Unnecessary conditional, expected left-hand side of `??` operator to be possibly null or undefined.","LogicalExpression","neverNullish",{"range":"125","text":"126"},{"range":"127","text":"128"},{"kind":"129","justification":"130"},[459,504],"{ attach(ref.current?.shadowRoot as ShadowRoot); }",[695,717],"persist(detail);",[1257,1328],"{ invalid ? reject(new Error('Invalid skin')) : resolve(sheets.get(skin)); }",[1257,1328],{"messageId":"131","fix":"132","desc":"133"},[1637,1674],"{ this.suspend(this.adorn(skin)); return; }",[1883,1920],"this.suspend(this.adorn(skin));",[2404,2435],"queueMicrotask(retrieve);","directive","root element guaranteed by index.html","replaceUsagesWithConstraint",{"range":"134","text":"135"},"Replace all usages of type parameter w